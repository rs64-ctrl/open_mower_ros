<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mower_comms_v2</name>
  <version>0.0.0</version>
  <description>The mower_comms_v2 package</description>
  <maintainer email="clemens1@familie-elflein.de">Clemens Elflein</maintainer>
  <license>CC BY-NC-SA 4.0</license>

  <url type="website">https://github.com/ClemensElflein/OpenMower</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 core -->
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>robot_localization</depend>

  <!-- Custom message packages -->
  <depend>xbot_msgs</depend>
  <depend>mower_msgs</depend>
  <depend>xesc_msgs</depend>
  <depend>nmea_msgs</depend>
  <depend>rtcm_msgs</depend>

  <!-- xbot_framework (provides service interface libs and codegen) -->
  <build_depend>xbot_framework</build_depend>

  <!-- System dependencies -->
  <build_depend>libgeographiclib-dev</build_depend>
  <exec_depend>libgeographiclib-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
