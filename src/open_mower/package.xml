<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>open_mower</name>
  <version>0.0.0</version>
  <description>The open_mower package</description>

  <maintainer email="clemens1@familie-elflein.de">Clemens Elflein</maintainer>
  <license>CC BY-NC-SA 4.0</license>

  <url type="website">https://github.com/ClemensElflein/OpenMower</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mower_msgs</depend>
  <depend>mower_simulation</depend>
  <depend>mower_map</depend>

  <exec_depend>joy_linux</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>teleop_twist_joy</exec_depend>
  <exec_depend>mbf_costmap_nav</exec_depend>
  <exec_depend>ftc_local_planner</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>ublox</exec_depend>
  <exec_depend>imu_tools</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>rtcm_msgs</exec_depend>
  <exec_depend>ntrip_client</exec_depend>
  <exec_depend>twist_mux_msgs</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
