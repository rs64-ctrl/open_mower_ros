<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>slic3r_coverage_planner</name>
    <version>0.0.0</version>
    <description>The slic3r_coverage_planner package</description>
    <maintainer email="clemens1@familie-elflein.de">Clemens Elflein</maintainer>
    <license>AGPLv3</license>

    <author email="clemens1@familie-elflein.de">Clemens Elflein</author>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>geometry_msgs</depend>
    <depend>nav_msgs</depend>
    <depend>std_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>tf2</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>builtin_interfaces</depend>
    <build_depend>libboost-dev</build_depend>
    <build_depend>libboost-system-dev</build_depend>
    <build_depend>libboost-thread-dev</build_depend>
    <build_depend>libboost-filesystem-dev</build_depend>

    <member_of_group>rosidl_interface_packages</member_of_group>

    <exec_depend>rosidl_default_runtime</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
