<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>ftc_local_planner</name>
    <version>2.0.0</version>
    <description>A simple FTC Planner implementation</description>
    <author>Clemens Elflein</author>
    <maintainer email="clemens.elflein+ros@gmail.com">Clemens Elflein</maintainer>
    <license>BSD</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>rosidl_default_generators</buildtool_depend>

    <depend>rclcpp</depend>
    <depend>rclcpp_lifecycle</depend>
    <depend>nav2_costmap_2d</depend>
    <depend>nav_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>std_msgs</depend>
    <depend>visualization_msgs</depend>
    <depend>pluginlib</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>
    <depend>tf2_geometry_msgs</depend>
    <depend>tf2_eigen</depend>
    <depend>mbf_abstract_core</depend>
    <depend>mbf_costmap_core</depend>
    <depend>mbf_utility</depend>
    <depend>mbf_msgs</depend>
    <depend>rcl_interfaces</depend>
    <depend>builtin_interfaces</depend>

    <build_depend>eigen3_cmake_module</build_depend>
    <build_depend>libeigen3-dev</build_depend>

    <member_of_group>rosidl_interface_packages</member_of_group>

    <exec_depend>rosidl_default_runtime</exec_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
