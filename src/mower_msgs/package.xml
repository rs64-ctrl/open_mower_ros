<?xml version="1.0"?>
<package format="3">
  <name>mower_msgs</name>
  <version>0.0.0</version>
  <description>The mower_msgs package</description>

  <maintainer email="clemens1@familie-elflein.de">Clemens Elflein</maintainer>
  <license>CC BY-NC-SA 4.0</license>

  <url type="website">https://github.com/ClemensElflein/OpenMower</url>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Runtime for generated interfaces -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Interface dependencies used in .msg/.srv -->
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>xesc_msgs</depend>

  <!-- Mark as interface package -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
