<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>mbf_costmap_nav</name>
    <version>0.4.0</version>
    <description>
        The mbf_costmap_nav package contains the costmap navigation server implementation of Move Base Flex (MBF).
        It provides the CostmapNavigationServer which binds MBF to a local and a global nav2_costmap_2d.
        Ported from ROS1 move_base_flex to ROS2 Jazzy.
    </description>
    <maintainer email="spuetz@uos.de">Sebastian Puetz</maintainer>
    <maintainer email="santos@magazino.eu">Jorge Santos</maintainer>
    <license>BSD-3-Clause</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>geometry_msgs</depend>
    <depend>mbf_abstract_core</depend>
    <depend>mbf_abstract_nav</depend>
    <depend>mbf_costmap_core</depend>
    <depend>mbf_msgs</depend>
    <depend>mbf_utility</depend>
    <depend>nav2_costmap_2d</depend>
    <depend>nav_msgs</depend>
    <depend>pluginlib</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_action</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>
    <depend>tf2</depend>
    <depend>tf2_ros</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
